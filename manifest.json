{
  "manifest_version": 3,
  "name": "拾词 · 生词本",
  "description": "右键收录英文阅读中遇到的生词：自动查中文释义、保留原句上下文，侧边栏抽认卡复习，可导出 CSV 或 Anki。",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "拾词 · 生词本",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content/content.js"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": ["contextMenus", "storage", "unlimitedStorage", "sidePanel", "alarms"],
  "host_permissions": [
    "https://dict.youdao.com/*",
    "https://api.dictionaryapi.dev/*"
  ]
}
